{
  "name": "vici-qa-crm",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev -w @vici/api\" \"npm run dev -w @vici/worker\" \"npm run dev -w @vici/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @vici/web",
    "test": "vitest run",
    "db:generate": "npm run generate -w @vici/db",
    "db:migrate": "npm run migrate:deploy -w @vici/db",
    "db:seed": "npm run seed -w @vici/db"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
