# Server values for apps/api and apps/worker. Copy to .env and fill in. Never commit .env.

# VICIdial (use a reporting-only user in production)
VICIDIAL_BASE_URL=https://dialer4.dialergiants.com/vicidial
VICIDIAL_API_USER=
VICIDIAL_API_PASS=
VICIDIAL_SOURCE=vici-crm

# Supabase (Project Settings -> Database / API)
# DATABASE_URL: transaction pooler, used by the app at runtime. Format:
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: session pooler, used by the Prisma CLI for migrations. Format:
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Public key, used only by `npm run dev:token -w @vici/api` (development login helper)
SUPABASE_PUBLISHABLE_KEY=

# AI providers
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# App
# Log level of api and worker: debug, info, warn or error (worker debug shows every VICIdial request)
LOG_LEVEL=info
PORT=4000
APP_TIMEZONE=America/New_York
REF_TIMEZONE=Asia/Karachi
