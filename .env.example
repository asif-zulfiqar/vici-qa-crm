# VICIdial (use a reporting-only user in production)
VICIDIAL_BASE_URL=https://dialer4.dialergiants.com/vicidial
VICIDIAL_API_USER=
VICIDIAL_API_PASS=
VICIDIAL_SOURCE=vici-crm

# Supabase (Project Settings -> Database / API)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# App
PORT=4000
WEB_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/New_York
REF_TIMEZONE=Asia/Karachi

# Web app (apps/web/.env) — only public values here
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_API_URL=http://localhost:4000